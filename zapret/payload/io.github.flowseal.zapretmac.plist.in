<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.flowseal.zapretmac</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/ZapretMac/bin/zapret-control</string>
        <string>-data-root</string>
        <string>@DATA_ROOT@</string>
        <string>-uid</string>
        <string>@USER_ID@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <key>StandardOutPath</key>
    <string>/Library/Application Support/ZapretMac/zapret.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/ZapretMac/zapret.log</string>
</dict>
</plist>
